<Project>

  <PropertyGroup>
    <!-- Release Please 更新根目录 VERSION，构建将正式版本投影至包和二进制。 -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- CLR 程序集标识独立于产品版本。 -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>

    <!-- 统一构建产物输出到 artifacts/ 目录（仅 bin，不含 obj） -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <UseArtifactsIntermediateOutput>false</UseArtifactsIntermediateOutput>
  </PropertyGroup>

</Project>
