{
  "name": "layerscape-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:docs": "node scripts/prepare-docs.mjs",
    "dev": "npm run prepare:docs && astro dev --host 127.0.0.1",
    "build": "npm run prepare:docs && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test scripts/test/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "@astrojs/markdown-remark": "7.3.5",
    "astro": "7.4.13",
    "github-slugger": "2.0.0",
    "parse-srcset": "1.0.2",
    "parse5": "8.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  }
}
