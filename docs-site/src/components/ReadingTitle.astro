---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import {readingPages} from '../data/reading-pages';
const id=Astro.locals.starlightRoute.id;
const content=readingPages[id];
---
{content?<div class="doc-title"><Default />{content.intro&&<p>{content.intro}</p>}<nav class="doc-actions" aria-label="本页相关操作">{content.links.map((link,index)=><a class:list={['doc-action',{'doc-action-primary':index===0}]} href={link.href}>{link.title}<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg></a>)}</nav></div>:<Default />}
