---
import '../styles/landing-motion.css';
---
<script>
  const hero = document.querySelector<HTMLElement>('.landing-hero');
  const shell = document.querySelector<HTMLElement>('.hero-shell');
  const stage = document.querySelector<HTMLElement>('.product-showcase');
  const wordmark = document.querySelector<HTMLElement>('.hero-wordmark');
  const progress = document.querySelector<HTMLElement>('.reading-progress span');
  const benefits = document.querySelector<HTMLElement>('.benefit-strip');
  const steps = document.querySelector<HTMLElement>('.start-steps');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
  const stacked = matchMedia('(max-width: 799px)');
  const animations = new Set<Animation>();
  const ease = 'cubic-bezier(.16,1,.3,1)';
  let progressFrame = 0;
  let heroVisible = true;
  let pointerX = 0;
  let signal: Animation | null = null;

  // All content is visible before enhancement; animation never owns visibility state.
  function play(element: Element | null, frames: Keyframe[], duration = 700, delay = 0, easing = ease) {
    if (!element || reduced.matches || document.hidden) return;
    const animation = element.animate(frames, {duration, delay, easing, fill:'backwards'});
    animations.add(animation);
    animation.finished.then(() => animations.delete(animation), () => animations.delete(animation));
  }
  function resetPointer() {
    pointerX = 0;
    wordmark?.style.removeProperty('--brand-x');
  }
  function settle() {
    animations.forEach(animation => animation.cancel());
    animations.clear();
    resetPointer();
    wordmark?.style.removeProperty('--brand-y');
  }
  function queueProgress() {
    if (progressFrame || document.hidden) return;
    progressFrame = requestAnimationFrame(() => {
      const range = document.documentElement.scrollHeight - innerHeight;
      const fraction = range > 0 ? Math.min(1, Math.max(0, scrollY / range)) : 0;
      progress?.style.setProperty('transform', 'scaleX(' + fraction + ')');
      if (wordmark && heroVisible && !reduced.matches) {
        wordmark.style.setProperty('--brand-x', pointerX + 'px');
        wordmark.style.setProperty('--brand-y', Math.min(85, scrollY * .2) + 'px');
      }
      progressFrame = 0;
    });
  }
  function enter() {
    if (!hero || hero.getBoundingClientRect().bottom < 0) return;
    hero.querySelectorAll('h1 span').forEach((line,index) => {
      play(line, [
        {clipPath:'inset(0 100% 0 0)', transform:'translateY(20px)'},
        {clipPath:'inset(0 0% 0 0)', transform:'none'}
      ], 780, index * 90);
    });
    play(wordmark, [{clipPath:'inset(0 100% 0 0)',opacity:0},{clipPath:'inset(0 0% 0 0)',opacity:1}], 900);
    play(stage?.querySelector('.deployer-image') ?? null, [
      {clipPath:'inset(0 100% 0 0 round 12px)',transform:'translateX(40px)'},
      {clipPath:'inset(0 0% 0 0 round 12px)',transform:'none'}
    ], 780, 100);
  }
  function connectBenefits() {
    const vertical = stacked.matches;
    play(benefits?.querySelector('.benefit-track > span') ?? null,
      [{transform:vertical?'scaleY(0)':'scaleX(0)',opacity:1},{transform:vertical?'scaleY(1)':'scaleX(1)',opacity:.35}], 1000);
    benefits?.querySelectorAll('.benefit-node').forEach((node,index) => {
      const style = getComputedStyle(node);
      play(node, [
        {transform:'scale(.8)',backgroundColor:style.backgroundColor,color:style.color},
        {transform:'scale(1.12)',backgroundColor:style.color,color:style.backgroundColor,offset:.45},
        {transform:'scale(1)',backgroundColor:style.backgroundColor,color:style.color}
      ], 600, index * 160);
    });
    sendSignal();
  }
  function sendSignal() {
    signal?.cancel();
    const pulse = benefits?.querySelector<HTMLElement>('.flow-pulse');
    const track = benefits?.querySelector<HTMLElement>('.benefit-track');
    if (!pulse || !track || reduced.matches || document.hidden) return;
    const vertical = stacked.matches;
    const distance = vertical ? track.clientHeight - 52 : track.clientWidth - 72;
    const translate = vertical ? 'translateY(' : 'translateX(';
    signal = pulse.animate([
      {transform:translate+'0px)',opacity:0},
      {opacity:1,offset:.15},
      {opacity:1,offset:.8},
      {transform:translate+Math.max(0,distance)+'px)',opacity:0}
    ], {duration:1100,easing:'cubic-bezier(.4,0,.2,1)'});
    const current = signal;
    animations.add(current);
    current.finished.then(()=>animations.delete(current),()=>animations.delete(current));
  }
  function revealSteps() {
    steps?.querySelectorAll('.step-number').forEach((number,index) => {
      play(number, [{clipPath:'inset(0 100% 0 0)',transform:'translateX(-16px)'},{clipPath:'inset(0 0% 0 0)',transform:'none'}], 650, index * 120);
    });
  }
  function openScenarioHash() {
    const target = document.getElementById(location.hash.slice(1));
    if (target instanceof HTMLDetailsElement && target.classList.contains('scenario')) target.open = true;
  }
  document.querySelectorAll<HTMLDetailsElement>('.scenario').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if (detail.open) play(detail.querySelector('.scenario-body'), [
        {clipPath:'inset(0 0 100% 0)',opacity:.3},
        {clipPath:'inset(0 0 0% 0)',opacity:1}
      ], 350);
      queueProgress();
    });
  });
  window.addEventListener('hashchange', openScenarioHash);
  openScenarioHash();
  benefits?.addEventListener('pointerenter',sendSignal);
  benefits?.addEventListener('focusin',sendSignal);
  shell?.addEventListener('pointermove', event => {
    if (reduced.matches || !finePointer.matches || !heroVisible || document.hidden) return;
    const bounds = shell.getBoundingClientRect();
    const travel = Math.min(28, Math.max(0, (bounds.width - (wordmark?.offsetWidth ?? 0)) / 2 - 16));
    pointerX = (Math.max(0,Math.min(1,(event.clientX-bounds.left)/bounds.width))-.5)*travel*2;
    queueProgress();
  });
  shell?.addEventListener('pointerleave', resetPointer);
  shell?.addEventListener('focusin', resetPointer);
  finePointer.addEventListener('change', resetPointer);
  reduced.addEventListener('change', () => { if (reduced.matches) settle(); });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      settle();
      cancelAnimationFrame(progressFrame);
      progressFrame = 0;
    } else queueProgress();
  });
  window.addEventListener('pagehide', settle);
  window.addEventListener('scroll', queueProgress, {passive:true});
  window.addEventListener('resize', queueProgress, {passive:true});
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (entry.target === shell) {
          heroVisible = entry.isIntersecting;
          if (!heroVisible) resetPointer();
          else queueProgress();
        } else if (entry.isIntersecting && entry.intersectionRatio >= .3) {
          if (entry.target === benefits) connectBenefits();
          if (entry.target === steps) revealSteps();
          observer.unobserve(entry.target);
        }
      }
    }, {threshold:[0,.3]});
    if (shell) observer.observe(shell);
    if (benefits) observer.observe(benefits);
    if (steps) observer.observe(steps);
  }
  enter();
  queueProgress();
  document.fonts.ready.then(queueProgress);
</script>
