{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "automerge": false,
  "pinDigests": true,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "workflow"
      ],
      "matchDepNames": [
        "splrad/steward"
      ],
      "matchFileNames": [
        ".github/workflows/steward-release-publish.yml"
      ],
      "enabled": true,
      "overrideDatasource": "git-refs",
      "overridePackageName": "https://github.com/splrad/steward.git",
      "versioning": "exact"
    },
    {
      "matchDepNames": [
        "splrad/steward"
      ],
      "groupName": "validated controller",
      "groupSlug": "validated-controller"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/channel-preflight.yml",
        ".github/workflows/steward-release-publish.yml",
        ".github/workflows/steward-release-channels.yml",
        ".github/workflows/pages.yml"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "jdx/mise"
      ],
      "enabled": true,
      "pinDigests": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/channel-preflight.yml",
        ".github/workflows/pages.yml",
        ".github/workflows/product-ci.yml",
        ".github/workflows/steward-release-channels.yml",
        ".github/workflows/steward-release-publish.yml"
      ],
      "matchDepTypes": [
        "github-runner"
      ],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:steward-release-publish|steward-release-channels|channel-preflight|pages)\\.yml$/"
      ],
      "matchStrings": [
        "repository: splrad/steward\\s+ref: (?<currentDigest>[a-f0-9]{40})",
        "(?:^|\\n)  STEWARD_CONTROLLER_SHA: (?<currentDigest>[a-f0-9]{40})(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "splrad/steward",
      "packageNameTemplate": "https://github.com/splrad/steward.git",
      "datasourceTemplate": "git-refs",
      "currentValueTemplate": "steward/validated-controller",
      "versioningTemplate": "exact"
    }
  ],
  "prBodyTemplate": "{{{replace \"^([^A-Za-z]*)This PR contains the following updates:\" \"$1### 依赖更新\" table}}}{{{warnings}}}{{{notes}}}{{{replace \"^([^#]*)### Release Notes\" \"$1### 上游发布说明\" changelogs}}}{{{controls}}}{{{footer}}}",
  "prBodyColumns": [
    "Package",
    "Type",
    "Update",
    "Change"
  ],
  "prBodyHeadingDefinitions": {
    "Package": "组件",
    "Type": "依赖类别",
    "Update": "更新类型",
    "Change": "版本变化"
  },
  "prFooter": "本 PR 由 [Renovate](https://github.com/renovatebot/renovate) 自动生成。"
}
