{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "automerge": false,
  "pinDigests": true,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "splrad/steward"
      ],
      "groupName": "validated controller",
      "groupSlug": "validated-controller"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/channel-preflight.yml",
        ".github/workflows/steward-release-publish.yml",
        ".github/workflows/steward-release-channels.yml",
        ".github/workflows/pages.yml"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "jdx/mise"
      ],
      "enabled": true,
      "pinDigests": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/channel-preflight.yml",
        ".github/workflows/pages.yml",
        ".github/workflows/product-ci.yml",
        ".github/workflows/steward-release-channels.yml",
        ".github/workflows/steward-release-publish.yml"
      ],
      "matchDepTypes": [
        "github-runner"
      ],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:steward-release-publish|steward-release-channels|channel-preflight|pages)\\.yml$/"
      ],
      "matchStrings": [
        "repository: splrad/steward\\s+ref: (?<currentDigest>[a-f0-9]{40})",
        "(?:^|\\n)  STEWARD_CONTROLLER_SHA: (?<currentDigest>[a-f0-9]{40})(?:\\r?\\n|$)",
        "uses: splrad/steward/\\.github/workflows/product-release\\.yml@(?<currentDigest>[a-f0-9]{40})"
      ],
      "depNameTemplate": "splrad/steward",
      "packageNameTemplate": "{{currentDigest}}",
      "datasourceTemplate": "custom.steward-controller",
      "currentValueTemplate": "steward/validated-controller",
      "versioningTemplate": "exact"
    }
  ],
  "prBodyTemplate": "{{{replace \"^([^A-Za-z]*)This PR contains the following updates:\" \"$1### 依赖更新\" table}}}{{{warnings}}}{{{notes}}}{{{replace \"^([^#]*)### Release Notes\" \"$1### 上游发布说明\" changelogs}}}{{{controls}}}{{{footer}}}",
  "prBodyColumns": [
    "Package",
    "Type",
    "Update",
    "Change"
  ],
  "prBodyHeadingDefinitions": {
    "Package": "组件",
    "Type": "依赖类别",
    "Update": "更新类型",
    "Change": "版本变化"
  },
  "prFooter": "本 PR 由 [Renovate](https://github.com/renovatebot/renovate) 自动生成。",
  "customDatasources": {
    "steward-controller": {
      "defaultRegistryUrlTemplate": "https://api.github.com/repos/splrad/steward/compare/{{packageName}}...steward%2Fvalidated-controller",
      "format": "json",
      "transformTemplates": [
        "($base := base_commit.sha; $tip := commits[-1].sha; $valid := function($value){$type($value) = \"string\" and $length($value) = 40 and $exists($match($value, /^[0-9a-f]+$/))}; $forward := status = \"ahead\" and behind_by = 0 and ahead_by > 0 and merge_base_commit.sha = $base and $valid($tip) and $tip != $base; {\"releases\": $valid($base) ? [{\"version\": \"steward/validated-controller\", \"digest\": $forward ? $tip : $base}] : []})"
      ]
    }
  }
}
