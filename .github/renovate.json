{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "github-actions"
  ],
  "automerge": false,
  "pinDigests": true,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/channel-preflight.yml",
        ".github/workflows/steward-release-publish.yml",
        ".github/workflows/steward-release-channels.yml",
        ".github/workflows/pages.yml"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "jdx/mise"
      ],
      "enabled": true,
      "pinDigests": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/channel-preflight.yml",
        ".github/workflows/pages.yml",
        ".github/workflows/product-ci.yml",
        ".github/workflows/steward-release-channels.yml",
        ".github/workflows/steward-release-publish.yml"
      ],
      "matchDepTypes": [
        "github-runner"
      ],
      "enabled": true
    }
  ],
  "prBodyTemplate": "{{{replace \"^([^A-Za-z]*)This PR contains the following updates:\" \"$1### 依赖更新\" table}}}{{{warnings}}}{{{notes}}}{{{replace \"^([^#]*)### Release Notes\" \"$1### 上游发布说明\" changelogs}}}{{{controls}}}{{{footer}}}",
  "prBodyColumns": [
    "Package",
    "Type",
    "Update",
    "Change"
  ],
  "prBodyHeadingDefinitions": {
    "Package": "组件",
    "Type": "依赖类别",
    "Update": "更新类型",
    "Change": "版本变化"
  },
  "prFooter": "本 PR 由 [Renovate](https://github.com/renovatebot/renovate) 自动生成。"
}
