{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "nuget"
  ],
  "automerge": false,
  "pinDigests": true,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "nuget"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchFileNames": [
        ".config/dotnet-tools.json"
      ],
      "enabled": true
    },
    {
      "matchDepNames": [
        "splrad/steward"
      ],
      "groupName": "validated controller",
      "groupSlug": "validated-controller",
      "rollbackPrs": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/channel-preflight.yml",
        ".github/workflows/steward-release-publish.yml",
        ".github/workflows/steward-release-channels.yml",
        ".github/workflows/pages.yml"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchPackageNames": [
        "jdx/mise"
      ],
      "enabled": true,
      "pinDigests": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/product-ci.yml",
        ".github/workflows/steward-release-publish.yml"
      ],
      "matchDepTypes": [
        "uses-with"
      ],
      "matchDatasources": [
        "dotnet-version"
      ],
      "matchPackageNames": [
        "dotnet-sdk"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/channel-preflight.yml",
        ".github/workflows/pages.yml",
        ".github/workflows/product-ci.yml",
        ".github/workflows/steward-release-channels.yml",
        ".github/workflows/steward-release-publish.yml"
      ],
      "matchDepTypes": [
        "github-runner"
      ],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(?:steward-release-publish|steward-release-channels|channel-preflight|pages)\\.yml$/"
      ],
      "matchStrings": [
        "repository: splrad/steward\\r?\\n[ \\t]+ref: (?<currentDigest>[a-f0-9]{40})[ \\t]+# (?<currentValue>controller-v[1-9][0-9]*)(?:\\r?\\n|$)",
        "(?:^|\\n)  STEWARD_CONTROLLER_SHA: (?<currentDigest>[a-f0-9]{40})[ \\t]+# (?<currentValue>controller-v[1-9][0-9]*)(?:\\r?\\n|$)",
        "uses: splrad/steward(?:/[A-Za-z0-9_.-]+)*@(?<currentDigest>[a-f0-9]{40})[ \\t]+# (?<currentValue>controller-v[1-9][0-9]*)(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "splrad/steward",
      "packageNameTemplate": "https://github.com/splrad/steward.git",
      "datasourceTemplate": "git-tags",
      "versioningTemplate": "regex:^controller-v(?<patch>[1-9][0-9]*)$"
    }
  ],
  "prBodyTemplate": "{{{replace \"^([^A-Za-z]*)This PR contains the following updates:\" \"$1### 依赖更新\" table}}}{{{warnings}}}{{{notes}}}{{{replace \"^([^#]*)### Release Notes\" \"$1### 上游发布说明\" changelogs}}}{{{controls}}}{{{footer}}}",
  "prBodyColumns": [
    "Package",
    "Type",
    "Update",
    "Change"
  ],
  "prBodyHeadingDefinitions": {
    "Package": "组件",
    "Type": "依赖类别",
    "Update": "更新类型",
    "Change": "版本变化"
  },
  "prFooter": "本 PR 由 [Renovate](https://github.com/renovatebot/renovate) 自动生成。"
}
