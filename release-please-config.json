{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": true,
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "pull-request-header": "请审阅下方版本说明。确认后合并，本次合并将启动该版本的正式构建。",
  "pull-request-footer": "本 PR 的文件差异包含 VERSION、CHANGELOG.md 和版本清单。",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "1.0.0",
      "version-file": "VERSION",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "新增功能",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "问题修复",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "性能改进",
          "hidden": false
        },
        {
          "type": "revert",
          "section": "回退与兼容调整",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "文档",
          "hidden": false
        },
        {
          "type": "build",
          "section": "构建与分发",
          "hidden": false
        },
        {
          "type": "deps",
          "section": "依赖更新",
          "hidden": false
        },
        {
          "type": "chore",
          "section": "维护",
          "hidden": false
        }
      ],
      "draft": true,
      "force-tag-creation": true
    }
  }
}
