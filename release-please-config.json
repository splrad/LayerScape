{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "separate-pull-requests": false,
  "include-v-in-tag": true,
  "include-component-in-tag": false,
  "pull-request-header": "以下版本和变更记录来自创建候选时的提交。审阅当前版本、兼容性和升级步骤，请查看本 PR 中各发行单元的说明文件及完整源码差异。",
  "pull-request-footer": "编辑生成稿前，添加 `release:editing` 标签，在 Actions 中确认正在写入候选的作业已结束，再刷新 PR 并编辑。",
  "packages": {
    ".": {
      "release-type": "simple",
      "initial-version": "1.0.0",
      "version-file": "VERSION",
      "changelog-path": "CHANGELOG.md",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "新增功能",
          "hidden": false
        },
        {
          "type": "fix",
          "section": "问题修复",
          "hidden": false
        },
        {
          "type": "perf",
          "section": "性能改进",
          "hidden": false
        },
        {
          "type": "revert",
          "section": "回退与兼容调整",
          "hidden": false
        },
        {
          "type": "docs",
          "section": "文档",
          "hidden": false
        },
        {
          "type": "build",
          "section": "构建与分发",
          "hidden": false
        },
        {
          "type": "deps",
          "section": "依赖更新",
          "hidden": false
        },
        {
          "type": "chore",
          "section": "维护",
          "hidden": false
        }
      ]
    },
    "validation/python-delivery": {
      "component": "python-acceptance",
      "release-type": "python",
      "initial-version": "0.1.0"
    }
  }
}
