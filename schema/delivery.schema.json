{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splrad.dev/schema/delivery.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositoryAuthors", "units"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositoryAuthors": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "evidence"],
        "properties": {
          "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "units": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "notesPath", "assets", "channels"],
        "properties": {
          "id": { "$ref": "#/$defs/key" },
          "path": { "type": "string", "minLength": 1 },
          "notesPath": { "type": "string", "minLength": 1 },
          "assets": {
            "type": "array", "minItems": 1, "maxItems": 996,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "name", "mediaType"],
              "properties": {
                "id": { "$ref": "#/$defs/key" },
                "name": { "type": "string", "minLength": 1, "maxLength": 200 },
                "mediaType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$" }
              }
            }
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["id", "required", "location"],
              "properties": {
                "id": { "$ref": "#/$defs/key" },
                "required": { "type": "boolean" },
                "location": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\u0000-\\u0020\\u007f]+$" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": { "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" } }
}
